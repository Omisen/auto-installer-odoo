[12.68006, "o", "\r\n================================================================\r\nFinal installation settings:\r\n  Odoo version : 18.0\r\n  Odoo user    : odoo\r\n  Database     : cliente_demo\r\n  DB user      : odoo"]
[12.680315, "o", "\r\n  HTTP port    : 8069\r\n  Install dir  : /opt/odoo/odoo18\r\n  Nginx        : no\r\n  Admin passwd : custom\r\n================================================================\r\n\r\n\u001b[2m2026-08-15T21:01:30.893525Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 supported OS \u001b[3mos\u001b[0m\u001b[2m=\u001b[0mubuntu \u001b[3mversion\u001b[0m\u001b[2m=\u001b[0m22.04 \u001b[3mcodename\u001b[0m\u001b[2m=\u001b[0mSome(\"jammy\")\r\n"]
