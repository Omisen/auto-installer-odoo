[12.707937, "o", "\u001b[?25h"]
[13.931265, "o", "\u001b[?25l\u001b[39D\u001b[38;5;10m?\u001b[39m Proceed with the installation? (y/N) y \u001b[K\r\u001b[40C\u001b[?25h"]
[14.002227, "o", "\u001b[?25l\u001b[40D\u001b[38;5;10m>\u001b[39m Proceed with the installation? \u001b[38;5;14mYes\u001b[39m\u001b[K\r\n\u001b[?25h\u001b[?25hnote: you can interrupt with Ctrl-C. the installer **undoes its own work** and \r\nthe system comes back as it was.\r\n\r\nthe interruption takes effect between one step and the next: the step in progress \r\nis carried to completion, because stopping an `apt` or a database initialisation \r\nhalfway would leave something worse than what was being avoided.\r\n\r\na second Ctrl-C exits **at once**: the system then stays half-done and is cleaned \r\nup with\r\n\r\n    sudo invok rollback\r\n\r\nthe state needed for that is recorded in /var/lib/invok/state.json after every step \u2014 it holds even if \r\nthe machine loses power.\r\n\r\n\u001b[32m\u2801\u001b[0m [0/25] prepare-opt-root                                                                           \r\u001b[2K\u001b[32m\u2801\u001b[0m [0/25] prepare-opt-root                                                                           \u001b[2m2026-08-15T21:01:32.215490Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::engine\u001b[0m\u001b[2m:\u001b[0m snapshot \u001b[3"]
[14.002843, "o", "mstep\u001b[0m\u001b[2m=\u001b[0mprepare-opt-root\r\n\u001b[2m2026-08-15T21:01:32.215547Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::steps::prepare_opt_root\u001b[0m\u001b[2m:\u001b[0m snapshot: prepare-opt-root \u001b[3mdir\u001b[0m\u001b[2m=\u001b[0m/opt/odoo \u001b[3mprestate\u001b[0m\u001b[2m=\u001b[0mUntracked \u001b[3minstance_home\u001b[0m\u001b[2m=\u001b[0mUntracked \u001b[3mwiden_from\u001b[0m\u001b[2m=\u001b[0mNone\r\n\u001b[2m2026-08-15T21:01:32.215741Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::engine\u001b[0m\u001b[2m:\u001b[0m run \u001b[3mstep\u001b[0m\u001b[2m=\u001b[0mprepare-opt-root \u001b[3mdry_run\u001b[0m\u001b[2m=\u001b[0mfalse\r\n\u001b[2m2026-08-15T21:01:32.216179Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::steps::prepare_opt_root\u001b[0m\u001b[2m:\u001b[0m run: directory created (owned root, awaiting the user) \u001b[3mdir\u001b[0m\u001b[2m=\u001b[0m/opt/odoo \u001b[3mmode\u001b[0m\u001b[2m=\u001b[0m755"]
[14.00292, "o", "\r\n"]
