[12.682238, "o", "\u001b[2m2026-08-15T21:01:30.895596Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 running through sudo confirmed \u001b[3msudo_user\u001b[0m\u001b[2m=\u001b[0mSome(\"root\")\r\n"]
[12.682462, "o", "\u001b[2m2026-08-15T21:01:30.895655Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m checking the disk space \u001b[3mtarget\u001b[0m\u001b[2m=\u001b[0m/opt/odoo \u001b[3mmeasured_on\u001b[0m\u001b[2m=\u001b[0m/opt \u001b[3mavailable_gb\u001b[0m\u001b[2m=\u001b[0m15 \u001b[3mrequired_gb\u001b[0m\u001b[2m=\u001b[0m5\r\n"]
[12.704508, "o", "\u001b[2m2026-08-15T21:01:30.917405Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 port available \u001b[3mport\u001b[0m\u001b[2m=\u001b[0m8069\r\n"]
[12.7076, "o", "\u001b[2m2026-08-15T21:01:30.920564Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 port available \u001b[3mport\u001b[0m\u001b[2m=\u001b[0m8072\r\n\u001b[2m2026-08-15T21:01:30.920605Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 present \u001b[3mcommand\u001b[0m\u001b[2m=\u001b[0m\"apt-get\"\r\n\u001b[2m2026-08-15T21:01:30.920625Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 present \u001b[3mcommand\u001b[0m\u001b[2m=\u001b[0m\"systemctl\"\r\n\u001b[2m2026-08-15T21:01:30.920699Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2139 optional, not found (installable if needed) \u001b[3mcommand\u001b[0m\u001b[2m=\u001b[0m\"nginx\"\r\n\u001b[2m2026-08-15T21:01:30.920745Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2139 optional, not found (installable if needed) \u001b[3mcommand\u001b[0m\u001b[2m=\u001b[0m\"certbot\"\r\n\u001b[?25l\u001b[38;5;10m?\u001b[39m Proceed with the installation? "]
