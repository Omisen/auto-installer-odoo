[0.05, "o", "\u001b[1;32m$\u001b[0m sudo invok --config demo.env </dev/null\r\n"]
[0.979953, "o", "\u001b[2m2026-08-15T20:52:30.535661Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 running through sudo confirmed \u001b[3msudo_user\u001b[0m\u001b[2m=\u001b[0mSome(\"ubuntu\")\r\nError: a completed installation is already registered on this machine.\r\n\r\n  Manifest : /var/lib/invok/state.json\r\n  Instance : Odoo 18.0, user 'odoo', database 'odoo', in /opt/odoo/odoo18\r\n  Steps    : 25 recorded\r\n\r\nto add a SECOND instance beside it:        --instance <name> --port <free port>\r\nto remove this one:                        sudo invok rollback\r\nto reinstall over it (manifest set aside): --force\r\n\r\nproceeding without an explicit choice would overwrite the manifest with every artifact marked pre-existing, and this instance would no longer be removable automatically.\r\n"]
[1.979953, "o", "\r\n\u001b[2m\u2500\u2500 and a port another instance has recorded \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\r\n"]
[2.979953, "o", "\u001b[1;32m$\u001b[0m sudo invok --config demo-2.env --instance cliente-x --port 8072 </dev/null\r\n"]
[3.899853, "o", "\u001b[2m2026-08-15T20:52:35.461747Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 Python interpreter \u001b[3mpython\u001b[0m\u001b[2m=\u001b[0m3.10\r\n\u001b[2m2026-08-15T20:52:35.461847Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 running as root confirmed\r\n\u001b[2m2026-08-15T20:52:35.461880Z\u001b[0m \u001b[32m INFO\u001b[0m \u001b[2minvok::checks\u001b[0m\u001b[2m:\u001b[0m \u2714 running through sudo confirmed \u001b[3msudo_user\u001b[0m\u001b[2m=\u001b[0mSome(\"ubuntu\")\r\nError: instance 'default' already claims port 8072, even if nothing is listening on it right now.\r\n\r\nchoose another one with --port (which moves the gevent port with it) or with --gevent-port, or remove that instance first."]
[3.949853, "o", "\r\n"]
