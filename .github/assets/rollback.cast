[0.035, "o", "\u001b[1;32m$\u001b[0m systemctl is-active odoo18 ; sudo invok list\r\n"]
[0.935, "o", "active\r\n"]
[0.97, "o", "INSTANCE             ODOO    STATE         DATABASE               DIRECTORY\r\ndefault              18.0    installed     odoo                   /opt/odoo/odoo18\r\n\r\n"]
[1.005, "o", "  default              /var/lib/invok/state.json\r\n"]
[1.905, "o", "\u001b[1;32m$\u001b[0m sudo invok rollback --yes\r\n"]
