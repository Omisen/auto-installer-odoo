[2.875, "o", "\r\n================================================================\r\n"]
[2.91, "o", "COMPLETE installation (25 steps): it will be uninstalled.\r\n"]
[2.945, "o", "Starting state: /var/lib/invok/state.json"]
[2.98, "o", "\r\n\r\nArtifacts of the installation:\r\n  Odoo version : 18.0\r\n"]
[3.015, "o", "  Odoo user    : odoo\r\n"]
[3.05, "o", "  Database     : odoo\r\n  DB user      : odoo\r\n  Install dir  : /opt/odoo/odoo18\r\n  Nginx        : no\r\n"]
[3.085, "o", "\r\nSteps to undo, in reverse order of execution:"]
[3.12, "o", "\r\n   1. patch-bashrc\r\n   2. write-control-script\r\n"]
[3.155, "o", "   3. nginx-reload\r\n   4. nginx-firewall\r\n"]
[3.19, "o", "   5. nginx-selinux\r\n   6. nginx-enable-site\r\n   7. nginx-write-config\r\n   8. nginx-install"]
[3.225, "o", "\r\n   9. setup-systemd\r\n  10. initialize-odoo-database\r\n  11. setup-data-dir\r\n  12. generate-config"]
[3.26, "o", "\r\n  13. install-python-requirements\r\n"]
[3.295, "o", "  14. create-virtualenv\r\n  15. clone-odoo-repo\r\n  16. create-database"]
[3.33, "o", "\r\n  17. create-db-role\r\n"]
[3.365, "o", "  18. setup-postgres\r\n  19. install-wkhtmltopdf\r\n  20. install-system-dependencies\r\n"]
[3.4, "o", "  21. bootstrap-prerequisites\r\n"]
[3.435, "o", "  22. setup-cache-dir\r\n  23. setup-log-dir\r\n  24. create-odoo-user\r\n"]
[3.47, "o", "  25. prepare-opt-root\r\n\r\nONLY what the installer created will be removed: pre-existing resources\r\n(databases, packages, configs, users already there) stay untouched.\r\nPostgreSQL, nginx and the common utilities (git/curl/wget) stay installed:\r\nuse --aggressive-rollback to purge those too."]
[3.505, "o", "\r\n"]
[3.54, "o", "================================================================"]
