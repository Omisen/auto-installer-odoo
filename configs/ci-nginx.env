# =============================================================================
# configs/ci-nginx.env — la stessa installazione di ci.env, ma **con Nginx**.
#
# Perché esiste (B-V3-7). Fino alla R15 la CI reale non aveva mai eseguito i
# cinque step nginx: `configs/ci.env` ha `WITH_NGINX="false"`, quindi uscivano
# tutti al primo `if` in ogni installazione mai fatta su una macchina vera. Il
# vhost non veniva scritto né validato da `nginx -t`, il default site non veniva
# rimosso né ripristinato, le regole ufw mai toccate.
#
# Non è una lacuna teorica: in questo progetto i difetti sono stati trovati
# quasi sempre da una macchina reale — A-RT-1, A-RT-2, A5.1-bis, A-R6-2,
# A-R6-3, A-R9-1 — e mai da una rilettura. L'unico difetto nginx mai trovato
# (A1.4, il reload nell'ordine sbagliato) è emerso da un test end-to-end, non
# leggendo il codice. Due fasi intere — A-V3-5 e A-V3-6 — vivevano solo su mock.
#
# Le differenze da ci.env sono **due righe**: `WITH_NGINX` e `NGINX_SERVER_NAME`.
# Tutto il resto è identico di proposito, così un fallimento che compare solo
# qui è attribuibile a nginx e a nient'altro.
# =============================================================================

ODOO_VERSION="18.0"
ODOO_USER="odoo"

# Stesso nome non-di-default di ci.env: se il rollback ricavasse gli artefatti
# dai default invece che dal manifesto, lascerebbe `citest` sul sistema.
DB_NAME="citest"
DB_USER="odoo"
DB_PASSWORD=""
ODOO_PORT="8069"
ODOO_ADMIN_PASSWD="ci-throwaway-passwd"
ODOO_LOGFILE=""

# --- le due righe che distinguono questo file --------------------------------

WITH_NGINX="true"

# `_` catch-all: sul runner non c'è un dominio, e il test interroga 127.0.0.1.
# Un server_name reale non aggiungerebbe copertura — quello che si vuole
# esercitare è la catena vhost → reload → upstream, non il DNS.
NGINX_SERVER_NAME="_"

# NGINX_OPEN_HTTPS_PORT deliberatamente **non** impostata.
#
# Aprirebbe la 443 su ufw, che sui runner GitHub è installato ma inattivo:
# lo step uscirebbe subito e il test non guadagnerebbe nulla. E soprattutto il
# flag non configura TLS (A-V3-6) — il vhost resta identico — quindi non c'è
# nulla di nuovo da osservare. Il caso "ufw attivo" resta coperto dai mock,
# dove si può modellare senza rischiare di chiudere fuori il runner da sé.
