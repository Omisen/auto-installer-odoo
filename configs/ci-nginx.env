# =============================================================================
# the same installation as ci.env, but **with nginx**.
#
# why it exists (B-V3-7): until R15 the real CI had never run the nginx steps —
# the base config disables them, so they exited at the first condition in every
# installation ever done on a real machine. the vhost was never written or
# validated, the default site never removed or restored, the firewall rules never
# touched.
#
# not a theoretical gap: in this project defects have almost always been found by
# a real machine and never by a re-reading. the only nginx defect ever found
# came from an end-to-end test, not from reading the code.
#
# the differences from the base config are **two lines**. everything else is
# identical on purpose, so a failure appearing only here is attributable to nginx
# and nothing else.
# =============================================================================

ODOO_VERSION="18.0"
ODOO_USER="odoo"

# the same non-default name: were the rollback to take artifacts from defaults
# instead of the manifest, it would leave ours on the system.
DB_NAME="citest"
DB_USER="odoo"
DB_PASSWORD=""
ODOO_PORT="8069"
ODOO_ADMIN_PASSWD="ci-throwaway-passwd"
ODOO_LOGFILE=""

# --- the two lines that set this file apart ----------------------------------

WITH_NGINX="true"

# the catch-all: there is no domain on a runner and the test queries the loopback
# address. a real server name would add no coverage — what is exercised is the
# vhost-reload-upstream chain, not DNS.
NGINX_SERVER_NAME="_"

# the HTTPS-port key is deliberately **unset**.
#
# it would open 443 on a firewall that is installed but inactive on a runner, so
# the step would exit at once. and the flag configures no TLS (A-V3-6) — the
# vhost stays identical — so there is nothing new to observe.
