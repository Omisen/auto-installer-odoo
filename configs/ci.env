# =============================================================================
# configs/ci.env — preset per il test di INTEGRAZIONE REALE in CI (R5)
# =============================================================================
# Usato da .github/workflows/integration.yml, che installa Odoo davvero su un
# runner/container effimero e poi verifica che `invok rollback`
# riporti il sistema pulito.
#
#   sudo ./target/release/invok --config configs/ci.env
#
# NON è un preset d'esempio per gli utenti: per quelli vedi il README. Qui i
# valori sono scelti per rendere il test *verificabile*, non per essere sensati
# su una macchina vera.
#
# A differenza di configs/dev.env e configs/production.env — che sono residui
# dell'era Bash, non versionati e con chiavi che il parser Rust non conosce —
# questo file usa **solo** le chiavi effettivamente riconosciute da
# `config::parse_env_file`. Una chiave sconosciuta produce un warning e viene
# ignorata: in CI sarebbe rumore che nasconde i problemi veri.
#
# Perché è nel repo nonostante `.gitignore` escluda `configs/*.env`: non
# contiene segreti. La password qui sotto vive quanto un container di CI.
# =============================================================================

ODOO_VERSION="18.0"
ODOO_USER="odoo"

# Nome database volutamente NON di default (`odoo`).
#
# È l'asserzione più importante di tutto il test: se il rollback ricavasse i
# nomi degli artefatti dai default invece che dalla configurazione persistita,
# cercherebbe un database `odoo` e lascerebbe `citest` sul sistema. Il test lo
# vedrebbe. È la regressione di A-R4-1, resa osservabile da un nome diverso.
DB_NAME="citest"
DB_USER="odoo"

# Vuota = autenticazione peer via socket Unix: l'utente di sistema `odoo` si
# collega al ruolo `odoo` senza password. È il percorso consigliato e quello
# che vogliamo esercitare in CI.
DB_PASSWORD=""

ODOO_PORT="8069"

# Non 'admin': in esecuzione non interattiva la password debole è un hard-stop
# (`InsecureAdminNonInteractive`), quindi con 'admin' la CI non partirebbe
# nemmeno. Valore usa-e-getta, la macchina viene distrutta a fine job.
ODOO_ADMIN_PASSWD="ci-throwaway-passwd"

# Log su journal/stdout: nessuna log dir da creare, un artefatto in meno da
# verificare dopo il rollback. Il percorso con ODOO_LOGFILE è coperto dai test
# per-step di `setup_log_dir`.
ODOO_LOGFILE=""

# Nginx fuori dal perimetro di questo test: occuperebbe la porta 80 e
# aggiungerebbe cinque step il cui rollback è già coperto end-to-end dai test
# su modello (`tests/rollback_e2e.rs`, 5 scenari). Qui interessa il nucleo:
# apt, PostgreSQL, sorgenti, venv, systemd.
WITH_NGINX="false"
