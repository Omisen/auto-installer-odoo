# =============================================================================
# preset for the REAL integration test in CI.
#
# used by the integration workflow, which really installs Odoo on an ephemeral
# runner or container and then checks that the rollback leaves the system clean:
#
#   sudo ./target/release/invok --config configs/ci.env
#
# NOT an example preset for users — see the README for those. these values are
# chosen to make the test *verifiable*, not to be sensible on a real machine.
#
# the file uses **only** the keys the `.env` parser actually recognises: an
# unknown key is a warning and is ignored, which in CI would be noise hiding the
# real problems.
#
# it is in the repository despite the ignore rule on this directory because it
# holds no secret: the password below lives as long as a CI container.
# =============================================================================

ODOO_VERSION="18.0"
ODOO_USER="odoo"

# a database name deliberately NOT the default.
#
# the whole test's most important assertion: were the rollback to take artifact
# names from defaults instead of the persisted config, it would look for the
# default one and leave ours on the system — and the test would see it.
DB_NAME="citest"
DB_USER="odoo"

# empty means peer authentication over the Unix socket: the system user connects
# to the role without a password. the recommended path, and the one to exercise.
DB_PASSWORD=""

ODOO_PORT="8069"

# not the weak default: non-interactively that is a hard stop, so the CI would
# not even start. a throwaway value — the machine is destroyed with the job.
ODOO_ADMIN_PASSWD="ci-throwaway-passwd"

# logging to the journal: no log directory to create, one artifact less to check
# after the rollback. the file path is covered by the per-step tests.
ODOO_LOGFILE=""

# nginx is outside this test's perimeter: it would take port 80 and add steps
# whose rollback the end-to-end model tests already cover. what matters here is
# the core — packages, PostgreSQL, sources, virtualenv, systemd.
WITH_NGINX="false"
