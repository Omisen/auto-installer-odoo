# =============================================================================
# CI configuration for a SECOND, NAMED instance (phase I4).
#
# the same as `ci.env` except in two respects, and both are the point of the
# file:
#
#   1. it does NOT name `ODOO_USER`, `DB_USER` or `DB_NAME`. those three are
#      exactly what `--instance` derives, and in the cascade an explicit value
#      beats a derived default — so a test using `ci.env` would install a named
#      instance that shares the first one's user, role and database. it would go
#      green while proving the opposite of what it claims.
#   2. a different HTTP port, because the first instance is up and holding the
#      other one. the gevent port follows it (`--port` moves the pair), so it is
#      not named here either.
#
# it is in the repository despite the ignore rule on this directory because it
# holds no secret: the password below lives as long as a CI runner.
# =============================================================================

ODOO_VERSION="18.0"

# empty means peer authentication over the Unix socket: the system user connects
# to the role without a password. with (α) that pair is `odoo-<instance>` on
# both sides, and this file is where that is exercised for real.
DB_PASSWORD=""

# 8069 belongs to the instance already installed: the preflight refuses it by
# reading the other manifest, even with nothing listening (A-V6-3).
ODOO_PORT="8169"

ODOO_ADMIN_PASSWD="ci-throwaway-passwd"

# journal/stdout, like the base config: a log file would add a step this job is
# not about.
ODOO_LOGFILE=""

WITH_NGINX="false"
