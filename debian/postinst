#!/bin/sh
# creates the short alias `vok` -> `invok`.
#
# a SYMLINK, not a second binary: two copies of one executable in /usr/bin would
# be wasted megabytes and two things that can diverge. the link is RELATIVE, so
# it stays valid under a chroot or an alternative root.
#
# a file that is not ours is not overwritten: an existing regular file at that
# path belongs to somebody else, so warn and give up the alias. the same rule the
# installer applies to customer artifacts.
set -e

case "$1" in
configure)
    if [ -e /usr/bin/vok ] && [ ! -L /usr/bin/vok ]; then
        echo "invok: /usr/bin/vok esiste e non è un collegamento simbolico." >&2
        echo "invok: alias 'vok' NON creato; usa il comando 'invok'." >&2
    else
        ln -sfn invok /usr/bin/vok
    fi
    ;;
esac

exit 0
