#!/bin/sh
# removes the alias created by postinst.
#
# two conditions, not one — the engine's `PreState` reasoning:
#   1. only on REMOVAL, never on an upgrade, which would otherwise leave the
#      user without the alias;
#   2. only if the link still points at our binary. repointed elsewhere, it is
#      no longer ours to delete.
set -e

case "$1" in
remove | purge)
    if [ -L /usr/bin/vok ] && [ "$(readlink /usr/bin/vok)" = "invok" ]; then
        rm -f /usr/bin/vok
    fi
    ;;
esac

exit 0
