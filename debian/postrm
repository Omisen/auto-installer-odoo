#!/bin/sh
# Rimuove l'alias `vok` creato da postinst.
#
# Due condizioni, non una — è lo stesso ragionamento del `PreState` del motore:
#   1. solo alla RIMOZIONE (`remove`/`purge`), mai su `upgrade`, o un
#      aggiornamento lascerebbe l'utente senza alias;
#   2. solo se il link punta ancora a `invok`. Se qualcuno l'ha ripuntato
#      altrove, quel link non è più il nostro e non è nostro da cancellare.
set -e

case "$1" in
remove | purge)
    if [ -L /usr/bin/vok ] && [ "$(readlink /usr/bin/vok)" = "invok" ]; then
        rm -f /usr/bin/vok
    fi
    ;;
esac

exit 0
